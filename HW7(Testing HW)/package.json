{
  "name": "campusflow-hw7",
  "version": "1.0.0",
  "description": "CampusFlow 學生課程任務管理系統與三層自動化測試",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:unit",
    "test:unit": "jest tests/unit --runInBand",
    "test:system": "jest tests/system --runInBand",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:system && npm run test:e2e"
  },
  "dependencies": { "express": "^5.1.0" },
  "devDependencies": { "@playwright/test": "^1.56.1", "jest": "^30.2.0", "supertest": "^7.1.4" },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
